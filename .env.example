# Segredo usado pelo Payload para assinar sessões/tokens. Gere uma string aleatória longa e
# única em produção (ex: `openssl rand -base64 32`).
PAYLOAD_SECRET=troque-este-valor-em-producao

# String de conexão do banco Postgres (Supabase). Veja o README para o formato exato
# (Session Pooler, recomendado para hospedar em serviços como o Render).
# Exemplo: postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/aee

# Segredo usado para autorizar a chamada ao endpoint POST /api/migrate (sincroniza o esquema
# do banco de dados). Gere um valor aleatório e nunca o exponha publicamente.
MIGRATE_SECRET=troque-este-valor-em-producao
